+package dev.ingamecreator.core.ui;
+
+public record BlueprintInspectorLayout(
+        int graphWidth,
+        int inspectorXOffset,
+        int inspectorYOffset,
+        int inspectorWidth,
+        boolean overlay) {
+
+    public static BlueprintInspectorLayout compute(int canvasWidth, boolean hasSelection) {
+        int width = Math.max(220, canvasWidth);
+        if (!hasSelection) return new BlueprintInspectorLayout(width, width, 0, 0, false);
+
+        if (width >= 620) {
+            int inspector = Math.min(230, width / 4);
+            inspector = Math.max(180, inspector);
+            int graph = Math.max(220, width - inspector - 8);
+            return new BlueprintInspectorLayout(graph, graph + 8, 0, inspector, false);
+        }
+
+        int inspector = Math.min(260, Math.max(180, width - 24));
+        int x = Math.max(8, width - inspector - 8);
+        return new BlueprintInspectorLayout(width, x, 8, inspector, true);
+    }
+}
